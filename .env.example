# .env.example
# Copy this file to .env and fill in your real values.
# Lines prefixed with '#' are comments. Uncomment and change as needed.


# ============================
# APP
# ============================
# APP_NAME=Irricontrol Signal Simulator API
# APP_VERSION=1.0.1
# API_V1_STR=/api/v1
ENVIRONMENT=development


# ============================
# CORS / FRONTEND
# ============================
ALLOWED_ORIGINS_CSV=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,null

# URL of your frontend on Netlify (or other platform). Used to whitelist CORS in production.
NETLIFY_APP_URL=https://your-app.netlify.app

# Public URL of the backend (required in production for serving image URLs).
# BACKEND_PUBLIC_URL=https://your-backend.onrender.com


# ============================
# AUTH
# ============================
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=your-password-here

# Change this to a strong random secret in production. Never commit the real value.
AUTH_JWT_SECRET=dev-secret-change-me

# Token expiry in minutes (default: 720 = 12h).
AUTH_JWT_EXPIRES_MIN=720


# ============================
# CLOUDRF
# ============================
# !!! KEEP THIS SECRET — never commit the real key to source control !!!
CLOUDRF_API_KEY=

# Override only if using a different CloudRF endpoint.
# CLOUDRF_API_URL=https://api.cloudrf.com/area


# ============================
# LOG / HTTP
# ============================
LOG_LEVEL=INFO
HTTP_TIMEOUT=60


# ============================
# MAPBOX (3D line-of-sight view)
# ============================
# !!! KEEP THIS SECRET — never commit the real token to source control !!!
# Public-scoped Mapbox token, served to the frontend only after login via
# GET /simulation/mapbox_token instead of being hardcoded in the JS bundle.
MAPBOX_ACCESS_TOKEN=
