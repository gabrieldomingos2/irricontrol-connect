{
  "name": "frontend",
  "version": "2.1.0",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./dist/output.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "watch:js": "node scripts/build-js.mjs --watch",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
